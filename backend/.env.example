# Structured metadata database
DATABASE_URL=postgresql://visual_rag:<same-postgres-password-as-root-env>@localhost:55432/visual_rag

# Authentication is disabled for trusted intranet testing.
# To enable single-user authentication, set this to 1 and generate an API key.
RAG_AUTH_ENABLED=0
RAG_API_KEY=
RAG_COOKIE_SECURE=0

# Vector database. Use QDRANT_URL for production/maintainer handoff.
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_data  # Local file-mode fallback only; do not use with QDRANT_URL in production.

# Embeddings. Ollama must be running and must have this model pulled.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Local answer generation, knowledge extraction, anomaly checks, and vision.
OLLAMA_MODEL=gemma4:12b-it-q4_K_M
OLLAMA_TIMEOUT=120

# PDF parsing and VLM page understanding.
PDF_LOADER=pymupdf4llm
PDF_MAX_UPLOAD_BYTES=52428800
PDF_MAX_FILENAME_LENGTH=180
PDF_MAX_PAGES=300
VLM_RENDER_DPI=160
VLM_MAX_PAGES=20
VLM_TIMEOUT=120
VLM_CONCURRENCY=4
VLM_CACHE=1
VLM_PAGE_TILES=1
VLM_TILE_GRID=2

# Knowledge node chunking and retrieval defaults.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_MODE=semantic
SEMANTIC_THRESHOLD=0.70
TOP_K=5
MANUAL_BOOST=0.15

# Optional OCR fallback and knowledge graph extraction controls.
OCR_DPI=180
OCR_LANG=chi_tra+eng
KG_EXTRACTION_USE_LLM=1
KG_EXTRACTION_TIMEOUT=18
KG_EXTRACTION_CHAR_BUDGET=9000

# Optional external DSM image-recognition API.
DSM_API_BASE_URL=http://localhost:3000
EXTERNAL_VISION_API_URL=http://localhost:3000
DSM_API_TIMEOUT=8
